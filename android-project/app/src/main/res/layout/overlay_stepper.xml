<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/bg_stepper"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingEnd="0dp">
    <FrameLayout
        android:id="@+id/drag_handle"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:minHeight="56dp"
        android:contentDescription="@string/xml_segurar_e_arrastar_para_mover_o_floater">
        <TextView
            android:textSize="20sp"
            android:textColor="@color/cx_text_muted"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/xml_str_9"
            android:letterSpacing="0.15"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="8dp">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/preset_panel"
            android:paddingBottom="6dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="13sp"
                android:textColor="@color/cx_text_primary"
                android:gravity="center"
                android:id="@+id/preset_chip_0"
                android:background="@drawable/bg_preset_chip"
                android:padding="8dp"
                android:focusable="true"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:minHeight="40dp"
                android:text="@string/xml_str"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/cx_text_primary"
                android:gravity="center"
                android:id="@+id/preset_chip_1"
                android:background="@drawable/bg_preset_chip"
                android:padding="8dp"
                android:focusable="true"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:minHeight="40dp"
                android:text="@string/xml_str"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/cx_text_primary"
                android:gravity="center"
                android:id="@+id/preset_chip_2"
                android:background="@drawable/bg_preset_chip"
                android:padding="8dp"
                android:focusable="true"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:text="@string/xml_str"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/stepper_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/cx_text_primary"
                android:gravity="center"
                android:id="@+id/btn_minus"
                android:background="@drawable/btn_circle"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="@dimen/stepper_btn_size"
                android:layout_height="@dimen/stepper_btn_size"
                android:text="@string/xml_str_4"
                android:contentDescription="@string/xml_diminuir_temperatura"/>
            <TextView
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/cx_text_primary"
                android:gravity="center"
                android:id="@+id/tv_temp"
                android:focusable="true"
                android:clickable="true"
                android:longClickable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="72dp"
                android:text="@string/xml_str_5"
                android:contentDescription="@string/xml_temperatura_toque_abre_programas_de_vent"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"/>
            <TextView
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/cx_text_primary"
                android:gravity="center"
                android:id="@+id/btn_plus"
                android:background="@drawable/btn_circle"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="@dimen/stepper_btn_size"
                android:layout_height="@dimen/stepper_btn_size"
                android:text="@string/xml_str_6"
                android:contentDescription="@string/xml_aumentar_temperatura"/>
        </LinearLayout>
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/cx_text_hi"
            android:gravity="center"
            android:id="@+id/btn_auto"
            android:background="@drawable/btn_auto"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:minWidth="140dp"
            android:text="@string/xml_auto_2"
            android:contentDescription="@string/xml_modo_automatico_ventoinha"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/sensor_row"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/tv_sensor_inside"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/xml_str"/>
            <TextView
                android:id="@+id/tv_sensor_outside"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/xml_str"/>
        </LinearLayout>
        <TextView
            android:id="@+id/tv_source"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/xml_str_7"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/drag_handle_end"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="52dp"
        android:layout_height="match_parent"
        android:minHeight="56dp"
        android:contentDescription="@string/xml_segurar_e_arrastar_para_mover_o_floater">
        <TextView
            android:textSize="20sp"
            android:textColor="@color/cx_text_muted"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/xml_str_9"/>
    </FrameLayout>
</LinearLayout>
