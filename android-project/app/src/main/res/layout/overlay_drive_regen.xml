<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/collapsed_circle"
        android:background="@drawable/bg_pill_green"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:foreground="@drawable/fg_circle_stroke">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <View
                android:id="@+id/top_half"
                android:background="@color/cx_accent"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <View
                android:id="@+id/bottom_half"
                android:background="@color/cx_accent"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>
        </LinearLayout>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/expanded_panel"
        android:background="@drawable/bg_panel"
        android:padding="12dp"
        android:visibility="gone"
        android:layout_width="220dp"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="13sp"
            android:textColor="@color/cx_text_secondary"
            android:gravity="center_horizontal"
            android:id="@+id/tv_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/xml_str_8"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/cx_text_primary"
            android:id="@+id/tv_regen_current"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/xml_regen_media"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">
            <TextView
                android:textStyle="bold"
                android:textColor="@color/cx_text_hi"
                android:gravity="center"
                android:id="@+id/btn_regen_high"
                android:background="@drawable/bg_preset_chip"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:text="@string/xml_forte_2"
                android:layout_weight="1"/>
            <TextView
                android:textStyle="bold"
                android:textColor="@color/cx_text_hi"
                android:gravity="center"
                android:id="@+id/btn_regen_mid"
                android:background="@drawable/bg_preset_chip"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:text="@string/xml_media"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"/>
            <TextView
                android:textStyle="bold"
                android:textColor="@color/cx_text_hi"
                android:gravity="center"
                android:id="@+id/btn_regen_low"
                android:background="@drawable/bg_preset_chip"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:text="@string/xml_fraca"
                android:layout_weight="1"/>
        </LinearLayout>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/cx_text_primary"
            android:id="@+id/tv_drive_current"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/xml_drive_confort"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">
            <TextView
                android:textStyle="bold"
                android:textColor="@color/cx_text_hi"
                android:gravity="center"
                android:id="@+id/btn_drive_eco"
                android:background="@drawable/bg_preset_chip"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:text="@string/xml_eco_2"
                android:layout_weight="1"/>
            <TextView
                android:textStyle="bold"
                android:textColor="@color/cx_text_hi"
                android:gravity="center"
                android:id="@+id/btn_drive_comfort"
                android:background="@drawable/bg_preset_chip"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:text="@string/xml_confort"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"/>
            <TextView
                android:textStyle="bold"
                android:textColor="@color/cx_text_hi"
                android:gravity="center"
                android:id="@+id/btn_drive_sport"
                android:background="@drawable/bg_preset_chip"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:text="@string/xml_sport_2"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
