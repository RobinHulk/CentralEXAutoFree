<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingTop="@dimen/ex_content_pad_v"
    android:paddingBottom="@dimen/ex_content_pad_v"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="52dp">
        <Button
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/cx_on_accent"
            android:id="@+id/subTabAtalhosIcones"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minWidth="0dp"
            android:text="@string/k_eyebrow_atalhos_icones"
            android:textAllCaps="false"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:backgroundTint="@color/cx_accent"/>
        <Button
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/cx_text_hi"
            android:id="@+id/subTabAtalhosWidgets"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minWidth="0dp"
            android:text="@string/k_nav_widgets"
            android:textAllCaps="false"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:layout_marginStart="10dp"
            android:backgroundTint="@color/cx_surface_alt"/>
        <Button
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/cx_text_hi"
            android:id="@+id/subTabAtalhosGestos"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minWidth="0dp"
            android:text="@string/k_eyebrow_atalhos_gestos"
            android:textAllCaps="false"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:layout_marginStart="10dp"
            android:backgroundTint="@color/cx_surface_alt"/>
        <Button
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/cx_text_hi"
            android:id="@+id/subTabAtalhosVolante"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minWidth="0dp"
            android:text="@string/k_eyebrow_midia"
            android:textAllCaps="false"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:layout_marginStart="10dp"
            android:backgroundTint="@color/cx_surface_alt"/>
    </LinearLayout>
    <ScrollView
        android:background="@color/ex_scrim_panel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/acessoContent"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/widgetsContent"
                android:padding="16dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/groupAtalhosGestos"
                android:padding="16dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@drawable/bg_central_ex_card"
                    android:padding="@dimen/ex_card_padding"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/swGesturesEnable"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"/>
                        <TextView
                            android:textSize="26sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✋"
                            android:layout_marginEnd="10dp"/>
                        <TextView
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/cx_text_primary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/xml_gestos_rapidos_titulo_curto"
                            android:maxLines="1"
                            android:layout_weight="1"
                            android:autoSizeTextType="uniform"
                            android:autoSizeMinTextSize="10sp"
                            android:autoSizeMaxTextSize="20sp"/>
                        <TextView
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/cx_accent"
                            android:id="@+id/infoGesturesHelp"
                            android:padding="2dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/k_help_question_mark"
                            android:layout_marginStart="6dp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="10dp">
                        <Button
                            android:textSize="16sp"
                            android:textColor="@color/cx_on_accent"
                            android:id="@+id/btnManageFavoritesHome"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:text="@string/xml_gerenciar_favoritos"
                            android:maxLines="2"
                            android:layout_weight="1"
                            android:textAllCaps="false"
                            android:layout_marginStart="4dp"
                            android:backgroundTint="@color/cx_accent"
                            android:autoSizeTextType="uniform"
                            android:autoSizeMinTextSize="9sp"
                            android:autoSizeMaxTextSize="16sp"/>
                        <TextView
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:id="@+id/btnGesturesRestoreOnBoot"
                            android:background="@drawable/bg_central_ex_card"
                            android:layout_width="52dp"
                            android:layout_height="match_parent"
                            android:foreground="?android:attr/selectableItemBackgroundBorderless"
                            android:text="↺"
                            android:layout_marginStart="6dp"/>
                        <TextView
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:id="@+id/btnAcSingleStep"
                            android:background="@drawable/bg_central_ex_card"
                            android:layout_width="52dp"
                            android:layout_height="match_parent"
                            android:foreground="?android:attr/selectableItemBackgroundBorderless"
                            android:text="1x"
                            android:layout_marginStart="4dp"/>
                    </LinearLayout>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/cx_text_secondary"
                        android:id="@+id/tvGesturesStatus"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text=""
                        android:maxLines="4"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/groupAtalhosVolante"
                android:padding="16dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false">
                    <LinearLayout
                        android:orientation="vertical"
                        android:background="@drawable/bg_central_ex_card"
                        android:padding="@dimen/ex_card_padding"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1">
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <com.google.android.material.switchmaterial.SwitchMaterial
                                android:id="@+id/swSwcMediaControl"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"/>
                            <TextView
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="@color/cx_text_primary"
                                android:ellipsize="end"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="@string/k_swc_media_control_title"
                                android:maxLines="1"
                                android:layout_weight="1"/>
                        </LinearLayout>
                        <TextView
                            android:textSize="16sp"
                            android:textColor="@color/cx_text_secondary"
                            android:ellipsize="end"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/k_swc_media_control_desc"
                            android:maxLines="3"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:background="@drawable/bg_central_ex_card"
                        android:padding="@dimen/ex_card_padding"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/ex_gutter">
                        <TextView
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/cx_text_primary"
                            android:ellipsize="end"
                            android:gravity="center_vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/xml_keyserver_gestos_volante"
                            android:maxLines="1"
                            android:drawablePadding="8dp"
                            android:drawableStart="@drawable/ic_card_link"
                            android:drawableTint="@color/cx_text_primary"/>
                        <TextView
                            android:textSize="16sp"
                            android:textColor="@color/cx_text_secondary"
                            android:ellipsize="end"
                            android:id="@+id/tvKeyServerStatus"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginTop="4dp"
                            android:text="@string/xml_keyserver_status_default"
                            android:maxLines="4"
                            android:layout_weight="1"/>
                        <Button
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:textColor="@color/cx_text_hi"
                            android:id="@+id/btnBindKeyServer"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:text="@string/xml_ativar"
                            android:maxLines="1"
                            android:textAllCaps="false"
                            android:backgroundTint="@color/cx_surface_alt"
                            android:autoSizeTextType="uniform"
                            android:autoSizeMinTextSize="9sp"
                            android:autoSizeMaxTextSize="17sp"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ex_gutter"
                    android:baselineAligned="false">
                    <LinearLayout
                        android:orientation="vertical"
                        android:background="@drawable/bg_central_ex_card"
                        android:padding="@dimen/ex_card_padding"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <com.google.android.material.switchmaterial.SwitchMaterial
                                android:id="@+id/swMediaBarFloater"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"/>
                            <TextView
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="@color/cx_text_primary"
                                android:ellipsize="end"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="@string/k_media_bar_floater_title"
                                android:maxLines="1"
                                android:layout_weight="1"/>
                        </LinearLayout>
                        <TextView
                            android:textSize="16sp"
                            android:textColor="@color/cx_text_secondary"
                            android:ellipsize="end"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/k_media_bar_floater_desc"
                            android:maxLines="3"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:background="@drawable/bg_central_ex_card"
                        android:padding="@dimen/ex_card_padding"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/ex_gutter">
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <com.google.android.material.switchmaterial.SwitchMaterial
                                android:id="@+id/swLyricsFloater"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"/>
                            <TextView
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="@color/cx_text_primary"
                                android:ellipsize="end"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="@string/k_lyrics_floater_title"
                                android:maxLines="1"
                                android:layout_weight="1"/>
                        </LinearLayout>
                        <TextView
                            android:textSize="16sp"
                            android:textColor="@color/cx_text_secondary"
                            android:ellipsize="end"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/k_lyrics_floater_desc"
                            android:maxLines="3"/>
                        <TextView
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/cx_accent"
                            android:id="@+id/btnLyricsConfig"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/k_lyrics_config_btn"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
