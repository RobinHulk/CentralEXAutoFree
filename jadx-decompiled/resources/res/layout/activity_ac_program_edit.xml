<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/cx_bg_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/cx_text_primary"
            android:id="@+id/tvAcEditTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/k_ac_edit_title_new"
            android:fontFamily="@font/rajdhani_semibold"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/cx_text_secondary"
            android:id="@+id/tvAcEditEmptyHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/k_ac_edit_empty_hint"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/containerAcSteps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/cx_text_primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/k_ac_edit_add_step_label"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp">
            <Button
                android:textSize="14sp"
                android:textColor="@color/cx_text_hi"
                android:id="@+id/btnAcAddTemp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/k_ac_edit_add_temp"
                android:maxLines="2"
                android:layout_weight="1"
                android:textAllCaps="false"
                android:layout_marginEnd="4dp"
                android:backgroundTint="@color/cx_surface"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="9sp"
                android:autoSizeMaxTextSize="14sp"/>
            <Button
                android:textSize="14sp"
                android:textColor="@color/cx_text_hi"
                android:id="@+id/btnAcAddFan"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/k_ac_edit_add_fan"
                android:maxLines="2"
                android:layout_weight="1"
                android:textAllCaps="false"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:backgroundTint="@color/cx_surface"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="9sp"
                android:autoSizeMaxTextSize="14sp"/>
            <Button
                android:textSize="14sp"
                android:textColor="@color/cx_text_hi"
                android:id="@+id/btnAcAddWait"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/k_ac_edit_add_wait"
                android:maxLines="2"
                android:layout_weight="1"
                android:textAllCaps="false"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:backgroundTint="@color/cx_surface"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="9sp"
                android:autoSizeMaxTextSize="14sp"/>
            <Button
                android:textSize="14sp"
                android:textColor="@color/cx_text_hi"
                android:id="@+id/btnAcAddRecirc"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/k_ac_edit_add_recirc"
                android:maxLines="2"
                android:layout_weight="1"
                android:textAllCaps="false"
                android:layout_marginStart="4dp"
                android:backgroundTint="@color/cx_surface"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="9sp"
                android:autoSizeMaxTextSize="14sp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp">
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/cx_text_primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/k_ac_edit_repeat"
                android:layout_weight="1"/>
            <Switch
                android:id="@+id/switchAcRepeat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp">
            <Button
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/cx_danger"
                android:id="@+id/btnAcEditDelete"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/k_ac_edit_delete"
                android:layout_weight="1"
                android:textAllCaps="false"
                android:layout_marginEnd="6dp"
                android:backgroundTint="@color/cx_surface"/>
            <Button
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/cx_surface"
                android:id="@+id/btnAcEditSave"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/k_ac_edit_save"
                android:layout_weight="1"
                android:textAllCaps="false"
                android:layout_marginStart="6dp"
                android:backgroundTint="@color/cx_accent"/>
        </LinearLayout>
        <Button
            android:textSize="15sp"
            android:textColor="@color/cx_text_hi"
            android:id="@+id/btnAcEditBack"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:minWidth="0dp"
            android:text="@string/k_ac_list_back"
            android:textAllCaps="false"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:backgroundTint="@color/cx_surface"/>
    </LinearLayout>
</ScrollView>
